PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/gymdrobe
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=replace-with-google-oauth-refresh-token

EMAIL_FROM=support@example.com
FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=your-google-oauth-client-id

VITE_GA_MEASUREMENT_ID=

# Optional shared shopping lists; enable only after paired-client/staging review.
SHOPPING_SYNC_ENABLED=false

# Native order push: both flags AND the admin database stop control must be on.
# Never commit real keys. Keep registration/delivery off until staging is verified.
PUSH_REGISTRATION_ENABLED=false
PUSH_DELIVERY_ENABLED=false
PUSH_TOKEN_ENCRYPTION_KEY=
# This backend instance accepts one APNs environment. Use separate staging/prod.
APNS_ENVIRONMENT=sandbox
APNS_KEY_ID=
APNS_TOPIC=com.gymdrobe.app
APNS_PRIVATE_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
