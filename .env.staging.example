# Template only. Keep the real .env.staging private; placeholders must fail.
# NODE_ENV=production is valid on a staging host; GYMDROBE_ENV selects isolation.
GYMDROBE_ENV=staging
GYMDROBE_STAGING_DATABASE=gymdrobe_staging_payment_review
MONGO_URI=mongodb://127.0.0.1:27017/gymdrobe_staging_payment_review?replicaSet=rs0
JWT_SECRET=replace-with-a-new-dedicated-staging-secret-at-least-32-characters
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-private-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-private-test-webhook-secret
FRONTEND_URL=http://localhost:5173
SHOPPING_SYNC_ENABLED=false
PUSH_REGISTRATION_ENABLED=false
PUSH_DELIVERY_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
META_CAPI_ACCESS_TOKEN=
