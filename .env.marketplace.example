# Add to the existing backend environment. Do not commit real values.
# Default off. See docs/MARKETPLACE_SETUP.md before activation.
MARKETPLACE_ENABLED=false
# Generate once using: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
# Store securely in the existing hosting secret manager; retain a secure backup.
MARKETPLACE_DATA_KEY=
# Existing HTTPS API origin, not a new paid service.
MARKETPLACE_PUBLIC_API_ORIGIN=https://gym-drobe-backend.onrender.com
# Existing MONGO_URI and JWT_SECRET remain required. Do not paste secrets in chat.
